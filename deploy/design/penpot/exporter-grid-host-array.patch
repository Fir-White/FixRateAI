@@ -0,0 +1,51 @@
+import { describe, expect, it } from 'vitest';
+
+import { translateGridTracks } from '@plugin/translators/translateLayout';
+import { FigmaPlatformDataError } from '@plugin/utils/figmaPlatformError';
+
+describe('Figma grid host-array compatibility', () => {
+  it('reads mixed fixed/flex sizing without invoking host array methods', () => {
+    const values: GridTrackSize[] = [
+      { type: 'FIXED', value: 180 },
+      { type: 'FLEX', value: 2 }
+    ];
+    const tracks = new Proxy(values, {
+      get(target, key, receiver): unknown {
+        if (key === 'map') {
+          throw new Error(
+            'in set_strokeStyleId: Cannot call with documentAccess: dynamic-page. Use node.setStrokeStyleIdAsync instead.'
+          );
+        }
+        return Reflect.get(target, key, receiver);
+      }
+    });
+    expect(translateGridTracks(tracks)).toEqual([
+      { type: 'fixed', value: 180 },
+      { type: 'flex', value: 2 }
+    ]);
+    expect(values).toEqual([
+      { type: 'FIXED', value: 180 },
+      { type: 'FLEX', value: 2 }
+    ]);
+  });
+
+  it('preserves an empty grid without synthesizing tracks', () => {
+    expect(translateGridTracks([])).toEqual([]);
+  });
+
+  it('still reports invalid track data', () => {
+    expect(() => translateGridTracks([null as unknown as GridTrackSize])).toThrow(
+      FigmaPlatformDataError
+    );
+  });
+
+  it('does not suppress unrelated errors from reading an entry', () => {
+    const tracks = new Proxy([{ type: 'FIXED', value: 180 }], {
+      get(target, key, receiver): unknown {
+        if (key === '0') throw new Error('unrelated read failure');
+        return Reflect.get(target, key, receiver);
+      }
+    }) as GridTrackSize[];
+    expect(() => translateGridTracks(tracks)).toThrow('unrelated read failure');
+  });
+});
