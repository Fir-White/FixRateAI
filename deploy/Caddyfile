{
    admin off
}
:8090 {
    respond /health "ok" 200
}
{$FIXRATE_ADDRESS::8080} {
    encode gzip
    @api path /api/*
    handle @api {
        reverse_proxy api:8000
    }
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
    }
}
