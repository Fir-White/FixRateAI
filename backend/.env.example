# Скопируйте в backend/.env:  cp .env.example .env
# Файл .env в git НЕ коммитим (см. .gitignore). Здесь только безопасные значения-заглушки.

# local | test | demo | prod
APP_ENV=local
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# PostgreSQL (engine/session и ORM-модели, карточка 2). Пароль ниже — заглушка для локального docker-compose.
# Формат: драйвер psycopg3 -> postgresql+psycopg://user:password@host:port/dbname
# Если docker-compose поднят с POSTGRES_PORT=5433, замените порт ниже на 5433.
DATABASE_URL=postgresql+psycopg://fixrate:ChangeMe-local-only@localhost:5432/fixrate

# Каталог для фотографий (карточка 5). Внутри: originals/ и processed/
STORAGE_DIR=var/storage

# Адрес будущего ML-сервиса (позже, за адаптером). Сейчас не используется.
ML_BASE_URL=http://127.0.0.1:8001
ML_TIMEOUT_SECONDS=30

# JWT (карточка 3). Сейчас не используется. В demo/prod заменить на длинную случайную строку.
JWT_SECRET=ChangeMe-long-random-string
JWT_EXPIRE_MINUTES=60
