# Скопируйте в .env и при необходимости измените значения.
# Пароли и секреты в git не коммитить.

APP_ENV=local
LOG_LEVEL=INFO

# Зарезервировано под карточку 2 (ORM). Пока не используется приложением.
DATABASE_URL=postgresql+psycopg://fixrate:fixrate@localhost:5432/fixrate

# Локальное хранилище фото (карточка 5). Каталог в .gitignore.
STORAGE_DIR=var/storage

# Будущий HTTP-адаптер ML (карточка 4+). Пока заглушка.
ML_BASE_URL=http://localhost:8001

# JWT (карточка 3). Смените перед любым общим демо.
JWT_SECRET=ChangeMe-JwtSecret-LocalOnly
JWT_EXPIRE_MINUTES=60
