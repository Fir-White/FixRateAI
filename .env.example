# Скопируйте в .env. Не публикуйте .env и не добавляйте его в Git.
# Подробные настройки: docs/service/runtime.md и docs/service/assistant.md.

# Приложение
DATABASE_URL=postgresql+psycopg://fixrate:replace_me@127.0.0.1:5432/fixrate
PHOTO_STORAGE_ROOT=./var/photos
COOKIE_SECURE=false
FIXRATE_DEFAULT_TIMEZONE=Asia/Yekaterinburg
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_DEMO_MODE=false
PHOTO_REVIEW_TIMEOUT_SECONDS=20
FORECAST_TIMEOUT_SECONDS=2
PHOTO_REVIEW_MAX_FILES=20
PHOTO_REVIEW_MAX_BYTES=52428800

# Docker Compose: задайте собственный постоянный пароль.
# POSTGRES_PASSWORD=
# FIXRATE_PORT=8000

# Локальные демонстрационные учётные записи: пароль не короче 12 символов.
# FIXRATE_DEMO_LOGIN=dispatcher@example.test
# FIXRATE_DEMO_PASSWORD=

# Локальная модель чата через Ollama.
# Для backend в Docker: http://host.docker.internal:11434
# ASSISTANT_PROVIDER=ollama
# OLLAMA_CHAT_BASE_URL=http://127.0.0.1:11434
# OLLAMA_CHAT_MODEL=qwen3.5:4b-q4_K_M
# OLLAMA_CHAT_DIGEST=sha256:<digest-из-ollama-api-tags>

# AI Tunnel: используйте API-ключ, а не пароль от аккаунта.
# Тексты и данные запроса отправляются во внешний сервис.
# AITUNNEL_API_KEY=
# AITUNNEL_CHAT_MODEL=qwen3.7-flash
# FIXRATE_CLOUD_AI=true
