# Copy to .env; scripts/start_backend.py loads it (never commit .env).
DATABASE_URL=postgresql+psycopg://fixrate:replace_me@127.0.0.1:5432/fixrate
PHOTO_STORAGE_ROOT=./var/photos
# true behind HTTPS; false for loopback HTTP development only.
COOKIE_SECURE=false
# Optional CORS middleware origins; API still enforces same-origin. Use the Vite proxy.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional CLIP weights live in the Hugging Face cache. Requests never download them.
# HF_HOME=/absolute/path/to/model-cache
# Frontend uses real API by default. This explicit flag creates a fixture-only demo build.
VITE_DEMO_MODE=false

# Maximum caller wait for photo analysis; range (0, 120] seconds.
PHOTO_REVIEW_TIMEOUT_SECONDS=20

# Compose only: set POSTGRES_PASSWORD to a unique persistent random hex password.
# POSTGRES_PASSWORD=
# FIXRATE_PORT=8000

# Independent per-forecast provider deadline: (0, 5] seconds; calendar budget stays 8s.
FORECAST_TIMEOUT_SECONDS=2
# Aggregate photo-review limits; upload remains capped at 10 MiB per image.
PHOTO_REVIEW_MAX_FILES=20
PHOTO_REVIEW_MAX_BYTES=52428800
# Optional compose.ml.yaml: existing host Hugging Face cache, mounted read-only.
# CLIP_CACHE_ROOT=/absolute/path/to/huggingface-cache

# Local demo accounts: scripts/start_local.py reads these from this checkout's .env.
# FIXRATE_DEMO_LOGIN is the dispatcher email; password is shared by all 7 demo users.
# Uncomment and choose your own email / password (12+ characters).
# FIXRATE_DEMO_LOGIN=dispatcher@example.test
# FIXRATE_DEMO_PASSWORD="replace-with-your-own-password"
# Optional emails for other roles; omitted values keep existing local settings.
# FIXRATE_DEMO_ADMIN_EMAIL=fixrate-demo-admin@example.test
# FIXRATE_DEMO_ENGINEER_EMAIL=fixrate-demo-engineer@example.test
# FIXRATE_DEMO_EXECUTOR_EMAIL=fixrate-demo-1@example.test
# Restart the helper to apply changes; only demo credentials are updated.

# Optional fully local vision reasoning (GPU): prepare and select the Docker profile.
# python scripts/prepare_local_vision.py
# python scripts/start_local.py --local-vision
# Native backend only, with a local Ollama service and downloaded/pinned model:
# PHOTO_REVIEW_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_VISION_MODEL=qwen3-vl:4b-instruct
# OLLAMA_VISION_DIGEST=sha256:<64-hex-digest-from-prepare>
# PHOTO_REVIEW_TIMEOUT_SECONDS=120
