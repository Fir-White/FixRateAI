# Copy to .env; scripts/start_backend.py loads it (never commit .env).
DATABASE_URL=postgresql+psycopg://fixrate:replace_me@127.0.0.1:5432/fixrate
PHOTO_STORAGE_ROOT=./var/photos
# true behind HTTPS; false for loopback HTTP development only.
COOKIE_SECURE=false
# Optional CORS middleware origins; API still enforces same-origin. Use the Vite proxy.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional CLIP weights live in the Hugging Face cache. Requests never download them.
# HF_HOME=/absolute/path/to/model-cache
# Frontend uses real API by default. This explicit flag creates a fixture-only demo build.
VITE_DEMO_MODE=false

# Maximum caller wait for photo analysis; range (0, 120] seconds.
PHOTO_REVIEW_TIMEOUT_SECONDS=20

# Compose only: set POSTGRES_PASSWORD to a unique persistent random hex password.
# POSTGRES_PASSWORD=
# FIXRATE_PORT=8000

# Independent per-forecast provider deadline: (0, 5] seconds; calendar budget stays 8s.
FORECAST_TIMEOUT_SECONDS=2
# Aggregate photo-review limits; upload remains capped at 10 MiB per image.
PHOTO_REVIEW_MAX_FILES=20
PHOTO_REVIEW_MAX_BYTES=52428800
# Optional compose.ml.yaml: existing host Hugging Face cache, mounted read-only.
# CLIP_CACHE_ROOT=/absolute/path/to/huggingface-cache
