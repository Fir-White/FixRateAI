    "PlanLoadPreview": {
      "additionalProperties": false,
      "properties": {
        "record": {
          "$ref": "#/$defs/DraftRecord"
        },
        "timezone": {
          "title": "Timezone",
          "type": "string"
        },
        "checked_at": {
          "format": "date-time",
          "title": "Checked At",
          "type": "string"
        },
        "resource_sha256": {
          "title": "Resource Sha256",
          "type": "string"
        },
        "source_state": {
          "enum": [
            "current",
            "stale",
            "published_snapshot"
          ],
          "title": "Source State",
          "type": "string"
        },
        "validation_status": {
          "enum": [
            "valid",
            "incomplete",
            "invalid"
          ],
          "title": "Validation Status",
          "type": "string"
        },
        "total_issues": {
          "title": "Total Issues",
          "type": "integer"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/PlanIssue"
          },
          "maxItems": 25,
          "title": "Issues",
          "type": "array"
        },
        "unknown_workers": {
          "title": "Unknown Workers",
          "type": "integer"
        },
        "published_tasks": {
          "title": "Published Tasks",
          "type": "integer"
        },
        "totals": {
          "$ref": "#/$defs/PlanLoadTotals"
        },
        "months": {
          "items": {
            "$ref": "#/$defs/PlanLoadMonth"
          },
          "maxItems": 14,
          "title": "Months",
          "type": "array"
        },
        "days": {
          "items": {
            "$ref": "#/$defs/PlanLoadDay"
          },
          "maxItems": 367,
          "title": "Days",
          "type": "array"
        }
      },
      "required": [
        "record",
        "timezone",
        "checked_at",
        "resource_sha256",
        "source_state",
        "validation_status",
        "total_issues",
        "issues",
        "unknown_workers",
        "published_tasks",
        "totals",
        "months",
        "days"
      ],
      "title": "PlanLoadPreview",
      "type": "object"
