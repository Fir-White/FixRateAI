{
  "$defs": {
    "DraftRecord": {
      "additionalProperties": false,
      "properties": {
        "draft_id": {
          "format": "uuid",
          "title": "Draft Id",
          "type": "string"
        },
        "revision": {
          "title": "Revision",
          "type": "integer"
        },
        "parent_revision": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parent Revision"
        },
        "import_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Import Id"
        },
        "source_kind": {
          "default": "catalog",
          "enum": [
            "catalog",
            "portfolio"
          ],
          "title": "Source Kind",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "starts_on": {
          "format": "date",
          "title": "Starts On",
          "type": "string"
        },
        "ends_on": {
          "format": "date",
          "title": "Ends On",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "format": "uuid",
          "title": "Created By",
          "type": "string"
        },
        "author_name": {
          "title": "Author Name",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "input_sha256": {
          "title": "Input Sha256",
          "type": "string"
        },
        "occurrence_count": {
          "title": "Occurrence Count",
          "type": "integer"
        },
        "segment_count": {
          "title": "Segment Count",
          "type": "integer"
        },
        "total_person_hours": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Total Person Hours"
        },
        "status": {
          "const": "draft",
          "default": "draft",
          "title": "Status",
          "type": "string"
        },
        "ready_for_real_plan": {
          "const": false,
          "default": false,
          "title": "Ready For Real Plan",
          "type": "boolean"
        },
        "change_kind": {
          "anyOf": [
            {
              "const": "undo",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Change Kind"
        },
        "undone_revision": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Undone Revision"
        },
        "restored_revision": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Restored Revision"
        }
      },
      "required": [
        "draft_id",
        "revision",
        "parent_revision",
        "import_id",
        "title",
        "starts_on",
        "ends_on",
        "created_at",
        "created_by",
        "author_name",
        "reason",
        "input_sha256",
        "occurrence_count",
        "segment_count",
        "total_person_hours"
      ],
      "title": "DraftRecord",
      "type": "object"
    },
    "PlanIssue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "row_number": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Row Number"
        },
        "occurrence_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Occurrence Id"
        },
        "segment_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Segment Id"
        },
        "date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "PlanIssue",
      "type": "object"
    },
