{
  "$defs": {
    "AgentCall": {
      "additionalProperties": false,
      "properties": {
        "tool": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Tool",
          "type": "string"
        },
        "arguments_json": {
          "description": "JSON object with tool arguments: path, query, body. For describe_tool: {\"name\":\"tool_name\"}.",
          "maxLength": 40000,
          "title": "Arguments Json",
          "type": "string"
        },
        "explanation": {
          "maxLength": 3000,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "arguments_json",
        "explanation"
      ],
      "title": "AgentCall",
      "type": "object"
    },
    "AgentStep": {
      "additionalProperties": false,
      "properties": {
        "answer": {
          "maxLength": 12000,
          "title": "Answer",
          "type": "string"
        },
        "calls": {
          "items": {
            "$ref": "#/$defs/AgentCall"
          },
          "maxItems": 3,
          "title": "Calls",
          "type": "array"
        }
      },
      "required": [
        "answer",
        "calls"
      ],
      "title": "AgentStep",
      "type": "object"
    },
    "ChatModelPreference": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "enum": [
            "ollama",
            "aitunnel"
          ],
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._][A-Za-z0-9._:/-]*$",
          "title": "Model",
          "type": "string"
        },
        "expected_revision": {
          "minimum": 0,
          "title": "Expected Revision",
          "type": "integer"
        }
      },
      "required": [
        "provider",
        "model",
        "expected_revision"
      ],
      "title": "ChatModelPreference",
      "type": "object"
    },
    "ConfirmAction": {
      "additionalProperties": false,
      "properties": {
        "payload_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Payload Sha256",
          "type": "string"
        },
        "confirmed": {
          "const": true,
          "title": "Confirmed",
          "type": "boolean"
        },
        "secret_values": {
          "additionalProperties": {
            "type": "string"
          },
          "maxProperties": 3,
          "title": "Secret Values",
          "type": "object"
        }
      },
      "required": [
        "payload_sha256",
        "confirmed"
      ],
      "title": "ConfirmAction",
      "type": "object"
    },
    "ConversationCreate": {
      "additionalProperties": false,
      "properties": {
        "agent": {
          "default": "assistant",
          "enum": [
            "assistant",
            "planner",
            "photo"
          ],
          "title": "Agent",
          "type": "string"
        },
        "title": {
          "default": "Новый диалог",
          "maxLength": 160,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "title": "ConversationCreate",
      "type": "object"
    },
    "FinalReply": {
      "additionalProperties": false,
      "properties": {
        "answer": {
          "maxLength": 12000,
          "minLength": 1,
          "title": "Answer",
          "type": "string"
        }
      },
      "required": [
        "answer"
      ],
      "title": "FinalReply",
      "type": "object"
    },
    "MessageCreate": {
      "additionalProperties": false,
      "properties": {
        "idempotency_key": {
          "format": "uuid",
          "title": "Idempotency Key",
          "type": "string"
        },
        "content": {
          "default": "",
          "maxLength": 12000,
          "title": "Content",
          "type": "string"
        },
        "attachment_ids": {
          "anyOf": [
            {
              "items": {
                "format": "uuid",
                "type": "string"
              },
              "maxItems": 20,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attachment Ids"
        },
        "model_preference_revision": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Preference Revision"
        }
      },
      "required": [
        "idempotency_key"
      ],
      "title": "MessageCreate",
      "type": "object"
    },
    "ResultView": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "description": "Последовательный путь по ключам одного JSON-результата, не список полей и не поиск оборудования. Обычно []: сначала прочитайте корневой ответ. Не угадывайте ключи.",
          "items": {
            "type": "string"
          },
          "maxItems": 6,
          "title": "Path",
          "type": "array"
        },
        "offset": {
          "default": 0,
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "limit": {
          "default": 25,
          "maximum": 25,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "q": {
          "default": "",
          "maxLength": 200,
          "title": "Q",
          "type": "string"
        },
        "text_offset": {
          "default": 0,
          "minimum": 0,
          "title": "Text Offset",
          "type": "integer"
        },
        "text_limit": {
          "default": 6000,
          "maximum": 6000,
          "minimum": 1,
          "title": "Text Limit",
          "type": "integer"
        }
      },
      "title": "ResultView",
      "type": "object"
    },
    "ToolSelection": {
      "additionalProperties": false,
      "properties": {
        "tools": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "title": "Tools",
          "type": "array"
        },
        "workbook_ids": {
          "description": "Previously sent XLSX attachments needed for this question; use only IDs from server context.",
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 4,
          "title": "Workbook Ids",
          "type": "array"
        }
      },
      "required": [
        "tools"
      ],
      "title": "ToolSelection",
      "type": "object"
    }
  }
}
