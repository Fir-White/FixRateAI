          "default": null,
          "title": "Address"
        },
        "timezone": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Timezone",
          "type": "string"
        }
      },
      "required": [
        "name",
        "timezone"
      ],
      "title": "BuildingCreate",
      "type": "object"
