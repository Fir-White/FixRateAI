# FixRate AI ML Service — Конфигурация окружения
ML_APP_NAME="FixRate AI ML Service"
ML_APP_VERSION="0.1.0"
ML_APP_ENV="local"
ML_LOG_LEVEL="INFO"
ML_HOST="0.0.0.0"
ML_PORT=8001

# CV Configuration
ML_CV_ENABLED=true
ML_CV_PROVIDER="mock"
ML_CV_MODEL_PATH="models/defect-yolo.pt"
ML_CV_CONFIDENCE_THRESHOLD=0.25
ML_CV_IOU_THRESHOLD=0.45
ML_CV_DEVICE="cpu"

# LLM Configuration
ML_LLM_ENABLED=true
ML_LLM_PROVIDER="mock"  # "mock" | "gigachat"
ML_LLM_API_KEY=""
ML_LLM_MODEL_NAME="mock-normalizer"
ML_LLM_TIMEOUT_SECONDS=15

# GigaChat Configuration (Сбер)
ML_GIGACHAT_CREDENTIALS=""  # Авторизационные данные (Auth Key в Base64)
ML_GIGACHAT_SCOPE="GIGACHAT_API_PERS"  # "GIGACHAT_API_PERS" (физлица) | "GIGACHAT_API_CORP" (юрлица)
ML_GIGACHAT_MODEL="GigaChat-Pro"  # "GigaChat-Pro" | "GigaChat-Lite" | "GigaChat-Max"
ML_GIGACHAT_VERIFY_SSL_CERTS=false  # Рекомендуется false для Linux без сертификатов НУЦ
ML_GIGACHAT_TIMEOUT=30.0

# RAG & Database Configuration
ML_RAG_CATALOG_PATH="data/demo_rates.json"
ML_DATABASE_URL=""
